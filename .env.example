# ============================================================================
# LeyAntilavado.org — variables de entorno
#
# Copia este archivo a `.env.local` (en la raíz del repo o en apps/web) y llena
# los valores. `.env.local` está en .gitignore: NUNCA lo subas.
#
# IMPORTANTE: el sitio público funciona SIN ninguna de estas variables. Las
# calculadoras, el contenido y todas las páginas abiertas compilan y corren con
# el archivo vacío. Lo único que deja de funcionar sin Supabase es el área
# privada de cumplimiento, que en ese caso muestra una pantalla que explica qué
# falta en lugar de romperse.
# ============================================================================

# ── Sitio ───────────────────────────────────────────────────────────────────
# URL pública canónica. Se usa en las etiquetas <link rel="canonical">, en Open
# Graph y en el sitemap. En desarrollo puedes dejar http://localhost:5400.
NEXT_PUBLIC_SITE_URL=https://leyantilavado.org

# Interruptor maestro de indexación. Mientras sea distinto de "true", TODAS las
# páginas salen con noindex. Ponlo en true sólo cuando el contenido esté
# revisado editorialmente.
NEXT_PUBLIC_SITE_INDEXABLE=false

# ── Supabase (OPCIONAL: sin esto el sitio público sigue funcionando) ─────────
# Supabase → tu proyecto → Project Settings → API.
#
# "Project URL". Es pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon public". También es pública por diseño: lo que protege los datos
# NO es esta clave, son las políticas RLS de supabase/migrations. Si tus
# políticas están bien, publicarla no expone nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role". SECRETA. Salta TODAS las políticas RLS.
# Sólo se usa en el servidor (tareas programadas). Si acaba en el navegador,
# cualquiera puede leer los expedientes de todas las organizaciones.
# Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Monitor regulatorio (OPCIONAL) ──────────────────────────────────────────
# Secreto que protege /api/cron/monitor-fuentes. Genera uno largo y aleatorio:
#   openssl rand -base64 48
# Se manda como cabecera:  Authorization: Bearer <valor>
# Sin este valor la ruta responde 401 siempre, que es el comportamiento seguro.
CRON_SECRET=

# ── Base de datos directa (OPCIONAL, sólo para migraciones locales) ─────────
# Supabase → Project Settings → Database → Connection string (URI).
# La usa `supabase db push` cuando no trabajas con el proyecto enlazado.
SUPABASE_DB_URL=
