# Variables de entorno de apps/web
#
# En producción NO existe un archivo `.env`: ServerAvatar las inyecta al proceso
# de PM2. Este archivo documenta cuáles hacen falta y qué pasa si faltan; los
# valores reales nunca se escriben aquí.
#
# Comprobar las que están puestas en el servidor:  pm2 jlist

# ── Sitio público ───────────────────────────────────────────────────────────
# Ya configuradas en producción.

# Sin ella, el build deja las canónicas y el sitemap apuntando a localhost: un
# despliegue "exitoso" que rompe el SEO en silencio.
NEXT_PUBLIC_SITE_URL=https://leyantilavado.org

# Arranca en `false` a propósito. Ponerla en `true` es lo que abre el sitio a
# los buscadores.
NEXT_PUBLIC_SITE_INDEXABLE=true

NODE_ENV=production
PORT=5400
HOSTNAME=127.0.0.1

# Protege /api/cron/*. Sin ella el endpoint responde 401 a todo, incluido el
# cron del propio servidor.
CRON_SECRET=

# ── Área privada (SaaS) ─────────────────────────────────────────────────────
# TODAVÍA NO configuradas. Sin ellas el sitio público funciona completo y el
# panel no arranca: `lib/supabase/configuracion.ts` mantiene la lista de las
# que faltan en vez de reventar.

# Del proyecto en Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: SÓLO servidor. Salta toda la RLS, así que no lleva el
# prefijo NEXT_PUBLIC_ y no debe aparecer nunca en el navegador. La usa el
# monitor de fuentes para escribir su resultado; mientras falte, ese cron
# responde 503 y lo dice.
SUPABASE_SERVICE_ROLE_KEY=

# ── Verificación antibot de los formularios ─────────────────────────────────
# Cloudflare Turnstile. Sin ellas los formularios siguen funcionando y quedan
# sólo con el límite de tasa por IP: el alta del directorio y el contacto
# aceptarían envíos automatizados.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cobros ──────────────────────────────────────────────────────────────────
# En modo prueba. Hoy el código sólo lee la clave secreta; cuando se cablee el
# webhook harán falta más, y se documentan aquí en ese momento y no antes.
STRIPE_SECRET_KEY=
